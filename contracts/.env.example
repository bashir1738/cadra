# ==============================================================================
# Cadra Protocol — Foundry Smart Contracts Environment Template
# Copy this file to contracts/.env for running forge script deployments.
# ==============================================================================

# Deployer Private Key for Foundry Broadcasts (0x-prefixed 32-byte hex)
# Must have testnet ETH on Unichain Sepolia for gas fees.
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Target Network RPC URL (Unichain Sepolia)
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
CHAIN_ID=1301

# Reactive Network Configuration (Reactive Lasna — Chain ID: 5318007)
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
UNICHAIN_CALLBACK_PROXY=0x9299472A6399Fd1027ebF067571Eb3e3D7837FC4

# Optional: Block Explorer Verification API Key
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Deployed Contract References on Unichain Sepolia (Public)
HOOK_ADDRESS=0x6f01d91B4BA3D5d5f97Fe955D5a0536ce97710C0
POOL_MANAGER_ADDRESS=0x29f2b190eacD76F0cBEC50bA669aab7F4600da4C
TOKEN0_USDC=0x31d0220469e10c4E71834a79b1f276d740d3768F
TOKEN1_WETH=0xB4AB6C3Ae39df89bA203F01ef08e39775Fe1F0c6
CADRA_CALLBACK=0x2687c7c2EDC5401C515C7364AB506cA9ecE55fE8
CADRA_REACTIVE=0xf937aee2e988557ba3774a8a41af349ef7112680

# ==============================================================================
# Cadra Protocol — Next.js Web Application Environment Template
# Copy this file to web/.env.local and adjust parameters as needed.
# ==============================================================================

# Target EVM Network (Unichain Sepolia Uniswap v4 Testnet)
NEXT_PUBLIC_CHAIN_ID=1301
NEXT_PUBLIC_CHAIN_NAME="Unichain Sepolia"
NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.uniscan.xyz

# Deployed Cadra Uniswap v4 Core Contracts (Public)
NEXT_PUBLIC_HOOK_ADDRESS=0x8a316B53c5cE57B34Fb1f071Ebe4A6C953c990c0
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=0x061216db95D483fc0e7e0c43976A62B7E207ba35
NEXT_PUBLIC_TOKEN0=0x7e0Ff8d515F8eb37a11181070bD87A1CE7Ef8111
NEXT_PUBLIC_TOKEN1=0xc7D51420E40fC986901CfB7c7197558CE8CD107E
NEXT_PUBLIC_CALLBACK_ADDRESS=0x0000000000000000000000000000000000000000

# Reactive Network (Lasna Testnet)
NEXT_PUBLIC_REACTIVE_CHAIN_ID=5318007
NEXT_PUBLIC_REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
NEXT_PUBLIC_REACTIVE_PROXY_ADDRESS=0x9299472A6399Fd1027ebF067571Eb3e3D7837FC4

# Privy Authentication & Embedded Wallet Configuration
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# WalletConnect / Reown Cloud Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Autonomous Bot Engine Private Keys (Optional: placeholders for bot runners)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
SWAPPER_PRIVATE_KEY=your_swapper_private_key_here
KEEPER_PRIVATE_KEY=your_keeper_private_key_here
CURATOR_TIGHT_KEY=your_curator_tight_private_key_here
CURATOR_WIDE_KEY=your_curator_wide_private_key_here
CURATOR_LAZY_KEY=your_curator_lazy_private_key_here
CURATOR_RECKLESS_KEY=your_curator_reckless_private_key_here

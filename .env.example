# ==============================================================================
# Cadra Protocol — Root Environment Template
# Copy this file to .env and replace placeholders with your actual keys.
# ==============================================================================

# Network & RPC Configuration (Unichain Sepolia — Chain ID: 1301)
CHAIN_ID=1301
CHAIN_NAME="Unichain Sepolia"
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
EXPLORER_URL=https://sepolia.uniscan.xyz

# Deployer Private Key (0x-prefixed 32-byte hex)
# WARNING: NEVER commit your real private key to version control!
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Deployed Contract Addresses on Unichain Sepolia (Public)
NEXT_PUBLIC_HOOK_ADDRESS=0x8a316B53c5cE57B34Fb1f071Ebe4A6C953c990c0
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=0x061216db95D483fc0e7e0c43976A62B7E207ba35
NEXT_PUBLIC_TOKEN0=0x7e0Ff8d515F8eb37a11181070bD87A1CE7Ef8111
NEXT_PUBLIC_TOKEN1=0xc7D51420E40fC986901CfB7c7197558CE8CD107E

# Reactive Network Configuration (Reactive Lasna — Chain ID: 5318007)
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
UNICHAIN_CALLBACK_PROXY=0x9299472A6399Fd1027ebF067571Eb3e3D7837FC4

# Frontend / RainbowKit Project ID (from cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Autonomous Bot Engine Accounts (Optional: placeholders for bot runners)
SWAPPER_PRIVATE_KEY=your_swapper_private_key_here
KEEPER_PRIVATE_KEY=your_keeper_private_key_here
CURATOR_TIGHT_KEY=your_curator_tight_private_key_here
CURATOR_WIDE_KEY=your_curator_wide_private_key_here
CURATOR_LAZY_KEY=your_curator_lazy_private_key_here
CURATOR_RECKLESS_KEY=your_curator_reckless_private_key_here
